   "source": [
    "work_df = df.copy()\n",
    "work_df[\"dest_zone\"] = work_df[\"dest_zone\"].fillna(\"Missing\")\n",
    "\n",
    "categorical_cols = [\"category\", \"dest_zone\", \"pack_type\", \"handling\", \"weather\", \"customs\"]\n",
    "work_df = pd.get_dummies(work_df, columns=categorical_cols, drop_first=True)\n",
    "\n",
    "X = work_df.drop(columns=[\"risk_event\"])\n",
    "y = work_df[\"risk_event\"]\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y\n",
    ")\n",
    "\n",
    "print(\"Train shape:\", X_train.shape, \"| Test shape:\", X_test.shape)\n",
    "print(\"Train positive rate:\", round(y_train.mean(), 4), \"| Test positive rate:\", round(y_test.mean(), 4))"
   ]
