   "source": [
    "smote = SMOTE(random_state=RANDOM_STATE)\n",
    "X_train_sm, y_train_sm = smote.fit_resample(X_train, y_train)\n",
    "\n",
    "smote_rf = RandomForestClassifier(random_state=RANDOM_STATE, n_estimators=300, n_jobs=-1)\n",
    "smote_rf.fit(X_train_sm, y_train_sm)\n",
    "smote_metrics, smote_preds, smote_proba, smote_cm = evaluate_model(\n",
    "    \"SMOTE RF\", smote_rf, X_test, y_test\n",
    ")\n",
    "\n",
    "comparison = pd.DataFrame([baseline_metrics, smote_metrics]).set_index(\"model\")\n",
    "display(comparison[[\"accuracy\", \"precision\", \"recall\", \"f1\", \"roc_auc\", \"false_negatives\", \"true_positives\"]].round(4))\n",
    "\n",
    "# Business signal: lower false negatives means fewer truly risky shipments are missed.\n",
    "fn_reduction = baseline_metrics[\"false_negatives\"] - smote_metrics[\"false_negatives\"]\n",
    "print(f\"False negatives reduced by: {fn_reduction}\")"
   ]
  },
